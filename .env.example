# App
PORT=3000
APP_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres@localhost:5432/lio

# JWT (RS256)
JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=

# OTP
OTP_TTL_SECONDS=120
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS=10
OTP_REQUEST_WINDOW_SECONDS=900
OTP_SECRET=change-me
