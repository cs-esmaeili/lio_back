# App
PORT=3000
# Comma-separated list of browser origins allowed by the CSRF origin check.
# Accepted forms:
#   APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
#   APP_ORIGIN=*
#   APP_ORIGIN=http://localhost:5173,*
# Matching is exact (no trailing slash); localhost and 127.0.0.1 are different.
# `*` disables the check (dev only; never in production).
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Logging
# Master switch for the custom logger. Set false to disable it entirely.
LOG_ENABLED=true
# Logical service name attached to every entry (Loki label).
SERVICE_NAME=lio-back
# Minimum level written: debug | info | warn | error | fatal.
LOG_LEVEL=info
# Request logging: all | errors | off.
LOG_REQUESTS=errors
# Also write JSON lines to logs/<scope>/ and logs/combined/ (stdout is always on).
LOG_FILE_ENABLED=true
# Log files (<scope>/ and combined/) older than this many days are pruned. 0 disables.
LOG_RETENTION_DAYS=14
# LOG_DIR=./logs

# Dev-only auth helper (POST /auth/dev/login). Keep false in production.
DEV_AUTH=false

# Uploads
# UPLOADS_DIR=/absolute/path/to/uploads
# UPLOADS_URL_PREFIX=/uploads/

# Database
DATABASE_URL=postgresql://postgres@localhost:5432/lio

# Session (opaque HttpOnly cookie)
# Sliding lifetime: extended whenever the session is used.
SESSION_TTL_DAYS=30
# Absolute lifetime: hard cap measured from the session's creation.
SESSION_ABSOLUTE_DAYS=90

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=

# OTP
OTP_TTL_SECONDS=120
OTP_LENGTH=4
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS=10
OTP_REQUEST_WINDOW_SECONDS=900
OTP_SECRET=change-me

# SMS
# Master switch. When false, SMS sends are skipped and logged.
SMS_ENABLED=true
# Active backend. Currently only `kavenegar` is supported.
SMS_PROVIDER=kavenegar

# Kavenegar (https://kavenegar.com) API key from the panel.
KAVENEGAR_API_KEY=
# API base URL. Override for a proxy or a mock server in tests.
KAVENEGAR_BASE_URL=https://api.kavenegar.com
# Verify Lookup template names, one per logical template.
KAVENEGAR_OTP_TEMPLATE=reqOTP
KAVENEGAR_ORDER_PAID_TEMPLATE=cartPaid

# Payment
# Active backend. Currently only `zarinpal` is supported.
PAYMENT_PROVIDER=zarinpal

# Zarinpal (https://zarinpal.com) merchant id from the panel.
ZARINPAL_MERCHANT_ID=
# Use the Zarinpal sandbox (https://sandbox.zarinpal.com) instead of production.
ZARINPAL_SANDBOX=false
# Optional overrides for the API and start-pay bases (proxy or mock server in tests).
# ZARINPAL_BASE_URL=https://api.zarinpal.com/pg/v4/payment
# ZARINPAL_START_PAY_URL=https://www.zarinpal.com/pg/StartPay
