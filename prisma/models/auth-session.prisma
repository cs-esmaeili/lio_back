model AuthSession {
  id               String    @id @default(uuid(7))
  userId           Int
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  familyId         String
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?
  lastUsedAt       DateTime?
  ip               String?
  userAgent        String?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}
