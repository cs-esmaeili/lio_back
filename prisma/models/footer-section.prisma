enum FooterSectionType {
  LINK
  CATEGORY
}

model FooterSection {
  id          Int               @id @default(autoincrement())
  sectionId   Int               @map("section_id")
  section     PageSection       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  type        FooterSectionType
  label       String?
  url         String?
  description String?
  fileId      Int?              @map("file_id")
  file        File?             @relation("FooterFile", fields: [fileId], references: [id], onDelete: Restrict)
  categoryId  Int?              @map("category_id")
  category    Category?         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sortOrder   Int               @default(0) @map("sort_order")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([sectionId, sortOrder], map: "footer_sections_section_id_sort_order_idx")
  @@map("footer_sections")
}
