model Location {
  id        Int       @id @default(autoincrement())
  province  String
  city      String
  addresses Address[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([province, city], map: "locations_province_city_idx")
  @@map("locations")
}
