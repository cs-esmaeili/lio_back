enum OtpPurpose {
  LOGIN
  RESET_PASSWORD
}

model Otp {
  id        Int        @id @default(autoincrement())
  phone     String
  codeHash  String
  purpose   OtpPurpose @default(LOGIN)
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int        @default(0)
  createdAt DateTime   @default(now())

  @@index([phone, createdAt])
  @@index([phone, purpose])
}
