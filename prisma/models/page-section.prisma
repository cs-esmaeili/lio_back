enum PageSectionType {
  SLIDER
  PRODUCT_LIST
}

enum PageSectionStatus {
  ACTIVE
  INACTIVE
}

model PageSection {
  id        Int               @id @default(autoincrement())
  pageId    Int               @map("page_id")
  page      Page              @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      PageSectionType
  sortOrder Int               @map("sort_order")
  status              PageSectionStatus  @default(ACTIVE)
  sliderSections      SliderSection[]
  productListSections ProductListSection[]
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@index([pageId, status, sortOrder], map: "page_sections_page_id_status_sort_order_idx")
  @@map("page_sections")
}
