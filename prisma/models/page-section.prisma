enum PageSectionType {
  SLIDER
  PRODUCT_LIST
  BANNER
  INTRODUCTION
  HEADER
  FOOTER
}

enum PageSectionLocation {
  SLIDER
  PRODUCT_LIST
  AMAZING_PRODUCTS
  BANNER
  BANNER_3
  BANNER_4
  INTRODUCTION
  HEADER
  FOOTER
}

enum PageSectionStatus {
  ACTIVE
  INACTIVE
}

model PageSection {
  id        Int               @id @default(autoincrement())
  pageId    Int?              @map("page_id")
  page      Page?             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      PageSectionType
  location  PageSectionLocation
  title     String?
  link      String?
  sortOrder Int               @map("sort_order")
  status              PageSectionStatus  @default(ACTIVE)
  sliderSections      SliderSection[]
  productListSections ProductListSection[]
  bannerSections      BannerSection[]
  introductionSection IntroductionSection?
  headerSections      HeaderSection[]
  footerSections      FooterSection[]
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@index([pageId, status, sortOrder], map: "page_sections_page_id_status_sort_order_idx")
  @@map("page_sections")
}
