model ProductListSection {
  id        Int         @id @default(autoincrement())
  sectionId Int         @map("section_id")
  productId Int         @map("product_id")
  sortOrder Int         @default(0) @map("sort_order")
  section   PageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([sectionId, sortOrder], map: "product_list_sections_section_id_sort_order_idx")
  @@map("product_list_sections")
}
