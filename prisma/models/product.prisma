model Product {
  id             Int      @id @default(autoincrement())
  name           String
  slug           String   @unique
  description    String?  @db.Text
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  stock          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
}
