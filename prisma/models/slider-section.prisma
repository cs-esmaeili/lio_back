model SliderSection {
  id            Int         @id @default(autoincrement())
  sectionId     Int         @map("section_id")
  section       PageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sortOrder     Int         @default(0) @map("sort_order")
  desktopFileId Int         @map("desktop_file_id")
  tabletFileId  Int         @map("tablet_file_id")
  mobileFileId  Int         @map("mobile_file_id")
  desktopFile   File        @relation("SliderDesktopFile", fields: [desktopFileId], references: [id], onDelete: Restrict)
  tabletFile    File        @relation("SliderTabletFile", fields: [tabletFileId], references: [id], onDelete: Restrict)
  mobileFile    File        @relation("SliderMobileFile", fields: [mobileFileId], references: [id], onDelete: Restrict)
  url           String?     @map("url")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([sectionId, sortOrder], map: "slider_sections_section_id_sort_order_idx")
  @@map("slider_sections")
}
