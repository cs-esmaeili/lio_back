model SliderSection {
  id            Int         @id @default(autoincrement())
  sectionId     Int         @unique(map: "slider_sections_section_id_key") @map("section_id")
  section       PageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  desktopFileId Int?        @map("desktop_file_id")
  tabletFileId  Int?        @map("tablet_file_id")
  mobileFileId  Int?        @map("mobile_file_id")
  desktopFile   File?       @relation("SliderDesktopFile", fields: [desktopFileId], references: [id], onDelete: SetNull)
  tabletFile    File?       @relation("SliderTabletFile", fields: [tabletFileId], references: [id], onDelete: SetNull)
  mobileFile    File?       @relation("SliderMobileFile", fields: [mobileFileId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("slider_sections")
}
