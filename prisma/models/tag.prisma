model Tag {
  id        Int          @id @default(autoincrement())
  parentId  Int?         @map("parent_id")
  parent    Tag?         @relation("TagTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Tag[]        @relation("TagTree")
  name      String
  imageId   Int?         @map("image_id")
  image     File?        @relation(fields: [imageId], references: [id], onDelete: SetNull)
  products  ProductTag[]
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@index([parentId], map: "tags_parent_id_idx")
  @@index([imageId], map: "tags_image_id_idx")
  @@map("tags")
}
