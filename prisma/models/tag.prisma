model Tag {
  id        Int          @id @default(autoincrement())
  parentId  Int?
  parent    Tag?         @relation("TagTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Tag[]        @relation("TagTree")
  name      String
  imageId   Int?
  image     File?        @relation(fields: [imageId], references: [id], onDelete: SetNull)
  products  ProductTag[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([parentId])
  @@index([imageId])
}
