{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist-scripts",
    "rootDir": "./",
    "declaration": false,
    "sourceMap": false,
    "incremental": false
  },
  "include": ["scripts/**/*.ts", "src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "dist-scripts",
    "test",
    "**/*spec.ts",
    "prisma.config.ts",
    "prisma"
  ]
}
